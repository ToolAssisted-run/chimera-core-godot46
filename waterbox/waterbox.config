{
  "coreName": "Godot 4.6",
  "systemId": "Godot",
  "systemNames": {
    "Godot": "Godot 4"
  },
  "author": "Godot Engine contributors (godotengine/godot, Juan Linietsky, Ariel Manzur); chimera core by Sergio Martin",
  "url": "https://github.com/godotengine/godot",
  "romFile": "game",
  "extensions": {
    ".pck": "Godot"
  },
  "_comment_extensions": "A Godot 4.6 game exported for a desktop is its engine plus a .pck file holding everything else; the .pck is what is opened. A game whose executable holds its .pck inside (Embed PCK) is opened as that executable, through a project. The other Godot cores run the other versions; each refuses a game of another version and names the core for it.",
  "deterministic": true,
  "memoryLayoutMiB": [
    1024,
    16,
    16,
    16,
    4096
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. Godot's own memory (its scenes, scripts, resources and the in-memory disk user:// lives on) and Mesa's (the textures and buffers OpenGL holds) on the heap and in mmap'd blocks. The game's .pck is not copied in: it is read from the file Chimera mounted.",
  "video": {
    "_comment": "What Godot draws with its Compatibility renderer (OpenGL 3.3) on the Mesa llvmpipe compiled into the core (made to generate the same code on every computer), read back after each frame. The live size is the game's window (its project settings' window size); capacity here is the largest window allowed.",
    "width": 1920,
    "height": 1080,
    "getBgra": "GetVideoBgra",
    "vsyncNumerator": 60,
    "vsyncDenominator": 1,
    "_comment_vsync": "A fallback: the rate is the Frame Rate setting, reported through GetVsyncNumerator."
  },
  "audio": {
    "_comment": "Godot's own mixer (its AudioServer, with the game's buses and effects), mixed for exactly one frame's share of a second each frame: 735 stereo samples at 44100 Hz at 60 frames a second. samplesPerFrame is capacity: the lowest frame rate allowed is 1.",
    "sampleRate": 44100,
    "channels": 2,
    "samplesPerFrame": 44100,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "settings": [
    {
      "name": "frameRate",
      "display": "Frame Rate",
      "type": "enum",
      "options": [
        "30",
        "50",
        "60",
        "120",
        "144"
      ],
      "default": "60",
      "description": "How many frames make a second of the game's time. Godot runs one step of the game per frame and tells the game that 1/rate of a second went by, as if its monitor refreshed at this rate. 60 is what most games are made for. It is part of the machine, so a movie needs the same value."
    },
    {
      "name": "startTime",
      "display": "Starting Clock",
      "type": "int",
      "min": 0,
      "max": 2147483647,
      "default": 946684800,
      "description": "The date and time the game reads (Time.get_unix_time_from_system and the date functions) when it starts, in seconds since 1970 (Unix time), in UTC; it then runs with the frames. The default is the first of January 2000. This is a setting, and not your computer's clock, so that a movie plays back the same on any day. It is part of the machine, so a movie needs the same value."
    },
    {
      "name": "verbose",
      "display": "Godot's Log",
      "type": "enum",
      "options": [
        "false",
        "true"
      ],
      "default": "false",
      "description": "'true' starts Godot with --verbose, so that its log (Tools > Export Core Log, or the console) says what it loads and draws. It changes nothing in the game."
    }
  ],
  "firmware": [],
  "input": {
    "name": "Godot",
    "_comment": "What a desktop gives a Godot game: the keyboard, the mouse and a game controller. Keys are sent as the keys of a US layout, with the letter they type. The mouse's place is Mouse X and Mouse Y, from 0 at the window's left or top edge to 65535 at the other. Each frame a wheel button is held turns the wheel one notch. The controller is player 1's, in Godot's own numbering (A at the bottom of the four face buttons).",
